# Copy to deploy/.env. Replace ALL placeholders, e.g. openssl rand -hex 32.
GCS_DB_PASSWORD=replace-me-db
MYSQL_ROOT_PASSWORD=replace-me-root
GCS_JWT_SECRET=replace-me-with-at-least-32-random-bytes
GCS_STORAGE_TOKEN=replace-me-with-another-32-random-bytes
GCS_MINIO_ACCESS_KEY=cloudbox
GCS_MINIO_SECRET_KEY=replace-me-minio
# Must be reachable from the user's browser, without scheme.
GCS_MINIO_PUBLIC_ENDPOINT=localhost:9000

# Independent schemas and internal RPC. Generate distinct random values.
GCS_SERVICE_TOKEN=replace-me-with-32-random-service-bytes
GCS_USER_DB_PASSWORD=replace-me-user-db
GCS_FILE_DB_PASSWORD=replace-me-file-db
GCS_SHARE_DB_PASSWORD=replace-me-share-db
GCS_NOTIFICATION_DB_PASSWORD=replace-me-notification-db
RABBITMQ_PASSWORD=replace-me-url-safe-rabbit-password
